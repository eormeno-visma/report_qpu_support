# ============================================
# CONFIGURACIÓN DE BASES DE DATOS (PLANTILLA)
# Copia este archivo como .env y completa los valores
# ============================================

# --- Base de Datos Principal (MySQL - Cluster Performance) ---
MYSQL_MAIN_HOST=
MYSQL_MAIN_PORT=3306
MYSQL_MAIN_USER=
MYSQL_MAIN_PASSWORD=
MYSQL_MAIN_DATABASE=performance

# --- Base de Datos de Logs (MySQL - Cluster Logs) ---
MYSQL_LOGS_HOST=
MYSQL_LOGS_PORT=3307
MYSQL_LOGS_USER=
MYSQL_LOGS_PASSWORD=
MYSQL_LOGS_DATABASE=logs

# --- Base de Datos MongoDB (Cluster MongoDB) ---
MONGO_HOST=
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_DATABASE=analytics
MONGO_AUTH_SOURCE=admin

